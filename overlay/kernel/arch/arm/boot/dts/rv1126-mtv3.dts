 */
&cpu_tsadc {
	status = "okay";
};

&npu_tsadc {
	status = "okay";
};

&otp {
	status = "okay";
};

&rng {
	status = "okay";
};

&ramoops {
	status = "okay";
};

&saradc {
	status = "okay";	/* adc-keys (recovery) на <&saradc 0> */
	vref-supply = <&vcc_1v8>;
};

/*
 * ============================================================
 * Suspend/Resume
 * ============================================================
 */
&rockchip_suspend {
	status = "okay";
	rockchip,sleep-debug-en = <1>;
	rockchip,sleep-mode-config = <
		(0
		| RKPM_SLP_ARMOFF
		| RKPM_SLP_PMU_PMUALIVE_32K
		| RKPM_SLP_PMU_DIS_OSC
		| RKPM_SLP_PMIC_LP
		)
	>;
	rockchip,wakeup-config = <
		(0
		| RKPM_GPIO_WKUP_EN
		)
	>;
};

/*
 * ============================================================
 * Video Processing
 * ============================================================
 */
&mpp_srv {
	status = "okay";
};

&rkvdec {
	status = "okay";
};

&rkvdec_mmu {
	status = "okay";
};

&rkvenc {
	//venc-supply = <&vdd_vepu>;	/* включать после замера окна PWM (см. vdd_vepu) */
	status = "okay";
