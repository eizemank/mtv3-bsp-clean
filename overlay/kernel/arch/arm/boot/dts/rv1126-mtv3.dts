/* USB 2.0 PHY0 - OTG port */
&u2phy0 {
	status = "okay";

	u2phy_otg: otg-port {
		status = "okay";
	};
};

/*
 * USB 2.0 PHY1 - Host port
 * TODO: Enable when carrier board with USB host connector is connected
 */
