/* ============================================================
 * Две камеры OV13850 на MTV3 (RV1126) — ФИНАЛЬНАЯ DTS-конфигурация
 * ============================================================
 *
 * Пины (из схемы MTV3, переведены в RK_Pxy):
 *   SDA  W19  GPIO1_D2   i2c1 SDA
 *   SCL  Y21  GPIO1_D3   i2c1 SCL
 *   PDN1 W20  GPIO1_D4   cam1 powerdown  -> &gpio1 RK_PD4
 *   PDN2 V20  GPIO1_D5   cam2 powerdown  -> &gpio1 RK_PD5
 *   XSD1 V19  GPIO1_D6   cam1 reset      -> &gpio1 RK_PD6
 *   XSD2 U18  GPIO1_D7   cam2 reset      -> &gpio1 RK_PD7
 *   XVS1 U19  GPIO2_A0   cam1 frame-sync -> &gpio2 RK_PA0  (опционально)
 *   XVS2 U20  GPIO2_A1   cam2 frame-sync -> &gpio2 RK_PA1  (опционально)
 *   MIPI_CLK1 GPIO2_A2   xvclk cam1 -> pinctrl mipicsi_clk1 (узел на RK_PA2!)
 *   MIPI_CLK2 GPIO2_A3   xvclk cam2 -> pinctrl mipicsi_clk0 (узел на RK_PA3!)
 *
 *  ВНИМАНИЕ: имена pinctrl-узлов "перевёрнуты" относительно пинов:
 *   mipicsi_clk0 = <2 RK_PA3 1> -> GPIO2_A3 = MIPI_CLK2 -> cam2
 *   mipicsi_clk1 = <2 RK_PA2 1> -> GPIO2_A2 = MIPI_CLK1 -> cam1
 *   Поэтому cam1 использует mipicsi_clk1, cam2 — mipicsi_clk0.
 *
 * Камеры:
 *   Camera 1: OV13850 @ i2c1 0x10 -> csi_dphy0 -> mipi_csi2 -> rkcif
 *   Camera 2: OV13850 @ i2c1 0x36 -> csi_dphy1 -> rkisp
 *
 * Параметры OV13850 (драйвер ov13850.c): xvclk 24MHz (CLK_MIPICSI_OUT),
 *   2 data-lanes, link-freq 300MHz, supplies avdd/dovdd/dvdd.
 *
 *  Осталось проверить (отмечено TODO):
 *   xvclk pinctrl ПОДТВЕРЖДЁН: mipicsi_clk0=GPIO2_A3, mipicsi_clk1=GPIO2_A2 (func 1)
 *   XSD1/XSD2: если на камерной плате заведены на XSHUTDOWN сенсора —
 *   раскомментировать reset-gpios и снять no-op __ov13850_power_off.
 */

/* ---------------- Сенсоры на i2c1 ---------------- */
&i2c1 {
	status = "okay";
	clock-frequency = <400000>;

	ov13850_1: ov13850@10 {
		compatible = "ovti,ov13850";
		reg = <0x10>;
		clocks = <&cru CLK_MIPICSI_OUT>;
		clock-names = "xvclk";
		power-domains = <&power RV1126_PD_VI>;
		pinctrl-names = "rockchip,camera_default";
		pinctrl-0 = <&mipicsi_clk1>;		/* GPIO2_A2 = MIPI_CLK1 */
		avdd-supply = <&vcc_avdd>;
		dovdd-supply = <&vcc_dovdd>;
		dvdd-supply = <&vcc_dvdd>;
		pwdn-gpios  = <&gpio1 RK_PD4 GPIO_ACTIVE_HIGH>;	/* PDN1 W20 */
		// reset-gpios = <&gpio1 RK_PD6 GPIO_ACTIVE_LOW>;	/* XSD1 V19 */
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "OV13850-CAM1";
		rockchip,camera-module-lens-name = "default";

		port {  
			ucam_out0: endpoint {
				remote-endpoint = <&csi_dphy1_input>;
				data-lanes = <1 2>;
			};
		};
	};

	// ov13850_2: ov13850@36 {
	// 	compatible = "ovti,ov13850";
	// 	reg = <0x36>;
	// 	clocks = <&cru CLK_MIPICSI_OUT>;
	// 	clock-names = "xvclk";
	// 	power-domains = <&power RV1126_PD_VI>;
	// 	pinctrl-names = "rockchip,camera_default";
	// 	pinctrl-0 = <&mipicsi_clk0>;		/* GPIO2_A3 = MIPI_CLK2 */
	// 	avdd-supply = <&vcc_avdd>;
	// 	dovdd-supply = <&vcc_dovdd>;
	// 	dvdd-supply = <&vcc_dvdd>;
	// 	pwdn-gpios  = <&gpio1 RK_PD5 GPIO_ACTIVE_HIGH>;	/* PDN2 V20 */
	// 	// reset-gpios = <&gpio1 RK_PD7 GPIO_ACTIVE_LOW>;	/* XSD2 U18 */
	// 	rockchip,camera-module-index = <1>;
	// 	rockchip,camera-module-facing = "front";
	// 	rockchip,camera-module-name = "OV13850-CAM2";
	// 	rockchip,camera-module-lens-name = "default";

	// 	port {
	// 		ucam_out1: endpoint {
	// 			remote-endpoint = <&mipi_in_ucam0>;
	// 			data-lanes = <1 2>;
	// 		};
	// 	};
	// };
};

/* ---------------- csi_dphy0 <- cam1, -> mipi_csi2 ---------------- */
&csi_dphy0 {
	status = "disabled";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_in_ucam0: endpoint@1 {
				reg = <1>;
				// remote-endpoint = <&ucam_out1>;
				data-lanes = <1 2>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi_csi2_input>;
				data-lanes = <1 2>;
			};
		};
	};
};

/* ---------------- csi_dphy1 <- cam2, -> rkisp_vir0 ---------------- */
&csi_dphy1 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi_dphy1_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&ucam_out0>;
				data-lanes = <1 2>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi_dphy1_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&isp_in>;
				data-lanes = <1 2>;
			};
		};
	};
};

/* ---------------- mipi_csi2: csi_dphy0 -> rkcif ---------------- */
&mipi_csi2 {
	status = "disabled";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy0_out>;
				data-lanes = <1 2>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in>;
				data-lanes = <1 2>;
			};
		};
	};
};

/* ISP CMA buffer для двух камер */
&isp_reserved {
	size = <0x5c00000>;
};

/* ---------------- rkcif (CIF путь cam1) ---------------- */
&rkcif {
	status = "disabled";
};

&rkcif_mipi_lvds {
	status = "disabled";

	port {
		cif_mipi_in: endpoint {
			remote-endpoint = <&mipi_csi2_output>;
			data-lanes = <1 2>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "disabled";

	port {
		cif_sditf: endpoint {
			remote-endpoint = <&isp_virt1_in>;
			data-lanes = <1 2>;
		};
	};
};

/* ---------------- rkisp + virtual ISP ---------------- */
&rkisp {
	status = "okay";
};

&rkisp_mmu {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			isp_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&csi_dphy1_output>;
			};
		};
	};
};

&rkisp_vir1 {
	status = "disabled";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			isp_virt1_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_sditf>;
			};
		};
	};
};

&rkispp {
	status = "okay";
	max-input = <2112 1568 30>;
};

&rkispp_vir0 {
	status = "okay";
};

&rkispp_vir1 {
	status = "disabled";
};

&rkispp_mmu {
	status = "okay";
};

/*
 * ============================================================
 * Pin Control
 * ============================================================
 */
&pinctrl {
	pmic {
		pmic_pins: pmic-pins {
			rockchip,pins =
				/* PMIC_SLEEP */
				<0 10 1 &pcfg_pull_none>,
				/* PMIC_INT */
				<0 9 0 &pcfg_pull_up>;
		};
	};

	user-leds {
		user_led_pins: user-led-pins {
			rockchip,pins =
				<3 17 0 &pcfg_pull_none>,	/* GPIO3_C1 - BLED */
				<3 0 0 &pcfg_pull_none>,	/* GPIO3_A0 - GLED */
				<2 9 0 &pcfg_pull_none>;	/* GPIO2_B1 - RLED */
		};
	};

	wifi {
		wifi_reg_on_h: wifi-reg-on-h {
			rockchip,pins =
				<0 6 0 &pcfg_pull_none>;	/* GPIO0_A6 */
		};

		/*
		 * MTV3 REV2: pull_none — на плате внешняя подтяжка R94 10K
		 * вверх к VCCIO_WL; внутренний pull-down давал делитель ~1.4В
		 * в серой зоне VIH + постоянную утечку.
		 */
		wifi_host_wake_h: wifi-host-wake-h {
			rockchip,pins =
				<0 8 0 &pcfg_pull_none>;	/* GPIO0_B0 */
		};
	};
};
