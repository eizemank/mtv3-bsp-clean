+/*
+ * =============================================================================
+ * I2C0 и PMIC RK809-2 конфигурация для MTV3
+ * =============================================================================
+ *
+ * RK809-2 подключен к I2C0 на адресе 0x20
+ * Конфигурация регуляторов соответствует схеме MTV3:
+ * - BUCK1-4: основные DC-DC преобразователи
+ * - BUCK5: 3.3V для питания LDO5-LDO9
+ * - LDO1-9: линейные регуляторы
+ * - SWOUT1/2: переключаемые выходы
+ *
+ * ВАЖНО: SWOUT2 питает VCC_3V3 который идет на eMMC!
+ * Вход SWOUT2 (VCC8) подключен к BUCK4 (VCC3V3_SYS)
+ *
+ * ПРИМЕЧАНИЕ: vcc*-supply убраны чтобы избежать
+ * циклических зависимостей при инициализации драйвера.
+ */
 &i2c0 {
-	u-boot,dm-spl;
-	status = "okay";
-	rk817_fg@20 {
-		u-boot,dm-spl;
-		compatible = "rk817,battery";
-		reg = <0x20>;
-		bat_res_up = <140>;
-		bat_res_down = <20>;
-	};
+    u-boot,dm-spl;
+    u-boot,dm-pre-reloc;
+    status = "okay";
+
+    rk809: pmic@20 {
+        compatible = "rockchip,rk809";
+        reg = <0x20>;
+        u-boot,dm-spl;
+        u-boot,dm-pre-reloc;
+
+        regulators {
+            u-boot,dm-spl;
+            u-boot,dm-pre-reloc;
+
+            /*
+             * BUCK1: VDD_LOGIC - 0.8V
+             * Питание логики CPU RV1126
+             * Диапазон: 0.5V - 1.35V (для DVFS)
+             */
+            vdd_logic: DCDC_REG1 {
+                regulator-name = "vdd_logic";
+                regulator-always-on;
+                regulator-boot-on;
+                regulator-min-microvolt = <500000>;
+                regulator-max-microvolt = <1350000>;
+                regulator-init-microvolt = <800000>;
+                regulator-initial-mode = <0x2>;
+                regulator-ramp-delay = <6001>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * BUCK2: VDD_ARM - 0.8V
+             * Питание ядра CPU ARM Cortex-A7
+             * Диапазон: 0.5V - 1.35V (для DVFS)
+             */
+            vdd_arm: DCDC_REG2 {
+                regulator-name = "vdd_arm";
+                regulator-always-on;
+                regulator-boot-on;
+                regulator-min-microvolt = <500000>;
+                regulator-max-microvolt = <1350000>;
+                regulator-init-microvolt = <800000>;
+                regulator-initial-mode = <0x2>;
+                regulator-ramp-delay = <6001>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * BUCK3: VCC_DDR - 1.5V
+             * Питание DDR3 памяти
+             * Напряжение задается внешним резисторным делителем
+             */
+            vcc_ddr: DCDC_REG3 {
+                regulator-name = "vcc_ddr";
+                regulator-always-on;
+                regulator-boot-on;
+                regulator-initial-mode = <0x2>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * BUCK4: VCC3V3_SYS - 3.3V
+             * Основная системная шина 3.3V
+             * Питает: VCC8 (вход SWOUT2), периферию
+             */
+            vcc3v3_sys: DCDC_REG4 {
+                regulator-name = "vcc3v3_sys";
+                regulator-always-on;
+                regulator-boot-on;
+                regulator-min-microvolt = <3300000>;
+                regulator-max-microvolt = <3300000>;
+                regulator-init-microvolt = <3300000>;
+                regulator-initial-mode = <0x2>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * BUCK5: VCC_BUCK5 - 3.3V
+             * Питание для VCC5/VCC6 (входы LDO)
+             * Согласно схеме MTV3: 3.3V
+             */
+            vcc_buck5: DCDC_REG5 {
+                regulator-name = "vcc_buck5";
+                regulator-always-on;
+                regulator-boot-on;
+                regulator-min-microvolt = <3300000>;
+                regulator-max-microvolt = <3300000>;
+                regulator-init-microvolt = <3300000>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * LDO1: VCC0V8 - 0.8V
+             * PMUIO_VDD_0V8, MIPI, USB
+             */
+            vcc0v8: LDO_REG1 {
+                regulator-name = "vcc0v8";
+                regulator-always-on;
+                regulator-boot-on;
+                regulator-min-microvolt = <800000>;
+                regulator-max-microvolt = <800000>;
+                regulator-init-microvolt = <800000>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * LDO2: VCC1V8 - 1.8V
+             * PMUIO_VDD_1V8, ADC, MIPI, USB
+             */
+            vcc1v8: LDO_REG2 {
+                regulator-name = "vcc1v8";
+                regulator-always-on;
+                regulator-boot-on;
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <1800000>;
+                regulator-init-microvolt = <1800000>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * LDO3: VCC_0V8 - 0.8V
+             * PLL_AVDD_0V8, USB_AVDD_0V8
+             */
+            vcc_0v8: LDO_REG3 {
+                regulator-name = "vcc_0v8";
+                regulator-always-on;
+                regulator-boot-on;
+                regulator-min-microvolt = <800000>;
+                regulator-max-microvolt = <800000>;
+                regulator-init-microvolt = <800000>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * LDO4: VCC_1V8 - 1.8V
+             * PLL_AVDD_1V8, VCCIO3/4/6
+             */
+            vcc_1v8: LDO_REG4 {
+                regulator-name = "vcc_1v8";
+                regulator-always-on;
+                regulator-boot-on;
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <1800000>;
+                regulator-init-microvolt = <1800000>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * LDO5: VCC_DOVDD - 1.8V
+             * Camera Digital I/O
+             */
+            vcc_dovdd: LDO_REG5 {
+                regulator-name = "vcc_dovdd";
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <1800000>;
+                regulator-init-microvolt = <1800000>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * LDO6: VCC_DVDD - 1.5V
+             * Camera Digital Core
+             */
+            vcc_dvdd: LDO_REG6 {
+                regulator-name = "vcc_dvdd";
+                regulator-min-microvolt = <1500000>;
+                regulator-max-microvolt = <1500000>;
+                regulator-init-microvolt = <1500000>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * LDO7: VCC_AVDD - 3.0V
+             * Camera Analog
+             */
+            vcc_avdd: LDO_REG7 {
+                regulator-name = "vcc_avdd";
+                regulator-min-microvolt = <3000000>;
+                regulator-max-microvolt = <3000000>;
+                regulator-init-microvolt = <3000000>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * LDO8: VCCIO_SD - 3.3V
+             * SD Card IO (переключаемое 1.8V/3.3V)
+             */
+            vccio_sd: LDO_REG8 {
+                regulator-name = "vccio_sd";
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <3300000>;
+                regulator-init-microvolt = <3300000>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * LDO9: VCC3V3_SD - 3.3V
+             * SD Card Power
+             */
+            vcc3v3_sd: LDO_REG9 {
+                regulator-name = "vcc3v3_sd";
+                regulator-min-microvolt = <3300000>;
+                regulator-max-microvolt = <3300000>;
+                regulator-init-microvolt = <3300000>;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * SWITCH1: VCC5V0_HOST - 5V
+             * USB Host Power (OFF по умолчанию)
+             */
+            vcc5v0_host: SWITCH_REG1 {
+                regulator-name = "vcc5v0_host";
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+
+            /*
+             * SWITCH2: VCC_3V3 - ключ от VCC3V3_SYS
+             * КРИТИЧЕСКИ ВАЖНО: питает eMMC!
+             * Должен быть всегда включен
+             */
+            vcc_3v3: SWITCH_REG2 {
+                regulator-name = "vcc_3v3";
+                regulator-always-on;
+                regulator-boot-on;
+                u-boot,dm-spl;
+                u-boot,dm-pre-reloc;
+            };
+        };
+
+        /* Кодек RK809 - отключен в U-Boot */
+        codec {
+            status = "disabled";
+        };
+    };
 };
 
 &u2phy0 {
