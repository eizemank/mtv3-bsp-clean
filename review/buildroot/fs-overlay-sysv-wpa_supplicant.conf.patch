From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zarnitza MTV3 <mtv3-bsp@zarnitza>
Date: Tue, 14 Oct 2026 13:02:00 +0300
Subject: [PATCH] board/rockchip/rv1126_rv1109: wpa_supplicant.conf template

SSID/PASSWORD placeholders in the shared fs-overlay-sysv used by all rv1126 boards; mtv3_network.sh writes its own config.
---
diff --git a/board/rockchip/rv1126_rv1109/fs-overlay-sysv/etc/wpa_supplicant.conf b/board/rockchip/rv1126_rv1109/fs-overlay-sysv/etc/wpa_supplicant.conf
new file mode 100644
index 00000000..bd98c11a
--- /dev/null
+++ b/board/rockchip/rv1126_rv1109/fs-overlay-sysv/etc/wpa_supplicant.conf
@@ -0,0 +1,15 @@
+ctrl_interface=/var/run/wpa_supplicant
+update_config=1
+ap_scan=1
+
+network={
+ ssid="SSID"
+ proto=RSN
+ key_mgmt=SAE WPA-PSK WPA-PSK-SHA256
+ pairwise=CCMP TKIP
+ scan_ssid=1
+ psk="PASSWORD"
+ sae_password="PASSWORD"
+ ieee80211w=1
+}
+
-- 
2.17.1

